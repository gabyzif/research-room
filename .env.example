# Neon Postgres (or any Postgres). Pooled connection for the app runtime:
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection, used only by `prisma migrate`. Same URL without `-pooler` in the host:
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"
APP_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"
# Fallback used only when a user hasn't connected their own OpenAI/Anthropic/OpenRouter key in account settings.
OPENROUTER_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: enables the Google Drive folder picker on export (Google Cloud → enable "Google Picker API" → create an API key)
GOOGLE_API_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
